{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Svara Tauri Spike",
  "version": "0.1.0",
  "identifier": "io.svara.desktop.spike.tauri",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Svara Tauri shell spike",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
