{
  "name": "@svara/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Svara desktop surface.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "shell:probe": "bash electron/run.sh",
    "spike:model": "bash electron/scripts/fetch-test-model.sh"
  },
  "dependencies": {
    "@svara/avatar": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "vite": "8.3.1"
  }
}
